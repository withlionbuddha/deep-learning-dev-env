FROM ubuntu:22.04 AS intel-levelzero-opencl-xpu

# -----------------------------------
# 기본 환경 변수
# -----------------------------------
ENV DEBIAN_FRONTEND=noninteractive

ENV HOME=/root
ENV SHELL=/bin/bash

# -----------------------------------
# 시스템 패키지 설치
# -----------------------------------
RUN apt-get update && apt-get install -y \
    sudo \
    curl \
    wget \
    vim \
    nano \
    tini \
    build-essential \
    gcc \
    g++ \
    make \
    pkg-config \
    ca-certificates \
    openssh-client \
    iputils-ping \
    net-tools \
    procps \
    gnupg \
    python3 \
    python3-pip \
    python3-venv \
    python-is-python3 \
 && rm -rf /var/lib/apt/lists/*


# -----------------------------------
# Intel GPU runtime 저장소
# Ubuntu 22.04
# -----------------------------------
RUN wget -qO - \
    https://repositories.intel.com/graphics/intel-graphics.key \
    | gpg --dearmor \
        --output /usr/share/keyrings/intel-graphics.gpg \
 && echo \
    "deb [arch=amd64,i386 signed-by=/usr/share/keyrings/intel-graphics.gpg] https://repositories.intel.com/graphics/ubuntu jammy arc" \
    > /etc/apt/sources.list.d/intel.gpu.jammy.list \
 && dpkg --add-architecture i386 \
 && apt-get update


# -----------------------------------
# Intel GPU Runtime
# -----------------------------------
RUN apt-get update && apt-get install -y \
    intel-opencl-icd \
    intel-level-zero-gpu \
    level-zero \
    level-zero-dev \
    clinfo \
 && rm -rf /var/lib/apt/lists/*


# -----------------------------------
# Intel GPU Runtime
# 미디어 / GUI / OpenVINO 계열
# -----------------------------------
RUN apt-get update && apt-get install -y \
    intel-media-va-driver-non-free \
    libmfx1 \
    libmfxgen1 \
    libvpl2 \
    libegl-mesa0 \
    libegl1-mesa \
    libgbm1 \
    libgl1-mesa-dri \
    libglx-mesa0 \
    libigdgmm12 \
    mesa-va-drivers \
    mesa-vulkan-drivers \
    va-driver-all \
 && rm -rf /var/lib/apt/lists/*


# -----------------------------------
# OpenCL 수준 Intel GPU
# -----------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    clinfo \
    gpg \
    ocl-icd-libopencl1 \
    ocl-icd-opencl-dev \
    intel-opencl-icd \
    libigc1 \
    libigdfcl1 \
    libigdgmm12 \
    libgl1 \
    libglib2.0-0 \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*


# ============================================================
# [수정]
# Intel oneAPI Base Toolkit 2024.2.1
#
# 수정 전:
#   Intel APT repository
#       ↓
#   intel-oneapi-runtime-compilers
#       ↓
#   현재 2026.1.1 설치
#
# 수정 후:
#   oneAPI Base Toolkit 2024.2.1 고정
# ============================================================

ARG ONEAPI_INSTALLER=l_BaseKit_p_2024.2.1.100_offline.sh

ARG ONEAPI_URL=https://registrationcenter-download.intel.com/akdlm/IRC_NAS/e6ff8e9c-ee28-47fb-abd7-5c524c983e1c/${ONEAPI_INSTALLER}


RUN wget -q "${ONEAPI_URL}" \
        -O "/tmp/${ONEAPI_INSTALLER}" \
 && chmod +x "/tmp/${ONEAPI_INSTALLER}" \
 && "/tmp/${ONEAPI_INSTALLER}" \
        -a \
        --silent \
        --eula accept \
 && rm -f "/tmp/${ONEAPI_INSTALLER}"


# ============================================================
# [수정]
# oneAPI shared library 등록
#
# 수정 전:
#   libimf.so 위치만 등록
#
# 수정 후:
#   libsycl / libimf 실제 설치 위치 등록
# ============================================================

RUN find /opt/intel/oneapi \
        -type f \( \
            -name "libsycl.so*" \
            -o -name "libimf.so*" \
        \) \
        -exec dirname {} \; \
    | sort -u \
    > /etc/ld.so.conf.d/intel-oneapi.conf \
 && ldconfig


# -----------------------------------
# oneAPI shell 환경
# -----------------------------------
RUN echo \
    'source /opt/intel/oneapi/setvars.sh >/dev/null 2>&1' \
    >> /etc/bash.bashrc


# ============================================================
# [추가]
# Build 단계에서 oneAPI library 존재 확인
# ============================================================

RUN echo "=== oneAPI SYCL libraries ===" \
 && find /opt/intel/oneapi \
        -name "libsycl.so*" \
        -print \
 && echo "=== oneAPI IMF libraries ===" \
 && find /opt/intel/oneapi \
        -name "libimf.so*" \
        -print \
 && echo "=== ldconfig ===" \
 && ldconfig -p \
        | grep -E "libsycl|libimf" \
        || true


# -----------------------------------
# 일반 사용자 생성
# -----------------------------------
RUN useradd -m -s /bin/bash dev \
 && echo "dev ALL=(ALL) NOPASSWD:ALL" \
    >> /etc/sudoers

# -----------------------------------
# 작업 디렉토리 생성
# -----------------------------------
RUN mkdir -p /home/workspace \
 && chown -R dev:dev /home/workspace

# -----------------------------------
# 사용자 전환
# -----------------------------------
USER dev

ENV HOME=/home/dev
ENV PATH=/home/dev/.local/bin:$PATH
ENV XDG_CACHE_HOME=/home/dev/.cache


WORKDIR /home/workspace


# -----------------------------------
# pip 최신화
# -----------------------------------
RUN python -m pip install --user --upgrade \
    pip \
    setuptools \
    wheel


# -----------------------------------
# Python 패키지 설치
# -----------------------------------
RUN python -m pip install --user --no-cache-dir \
    numpy \
    pandas \
    matplotlib \
    scikit-learn \
    wget \
    threadpoolctl



