FROM intel-levelzero-opencl-xpu AS intel-levelzero-opencl-xpu-tensorflow

# ============================================================
# [수정]
# TensorFlow + Intel Extension for TensorFlow
#
# 수정 전:
# tensorflow==2.15.1
# intel-extension-for-tensorflow[xpu]
#
# 수정 후:
# tensorflow==2.15.1
# intel-extension-for-tensorflow[xpu]==2.15.0.1
# ============================================================

RUN python -m pip install --user --no-cache-dir \
    "tensorflow==2.15.1" \
    "intel-extension-for-tensorflow[xpu]==2.15.0.1"

# -----------------------------------
# Python 패키지 설치
# -----------------------------------
RUN python -m pip install --user --no-cache-dir \
    numpy \
    pandas \
    matplotlib \
    scikit-learn \
    wget


