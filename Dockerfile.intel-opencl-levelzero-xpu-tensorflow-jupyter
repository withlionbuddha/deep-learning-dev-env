FROM intel-levelzero-opencl-xpu \
    AS intel-levelzero-opencl-xpu-tensorflow


# ============================================================
# [수정]
# TensorFlow + Intel Extension for TensorFlow
#
# 수정 전:
#
# tensorflow==2.15.1
# intel-extension-for-tensorflow[xpu]
#
# 수정 후:
#
# tensorflow==2.15.1
# intel-extension-for-tensorflow[xpu]==2.15.0.2
# ============================================================

RUN python -m pip install --user --no-cache-dir \
    "tensorflow==2.15.1" \
    "intel-extension-for-tensorflow[xpu]==2.15.0.1"


# -----------------------------------
# Python 패키지 설치
# -----------------------------------
RUN python -m pip install --user --no-cache-dir \
    numpy \
    pandas \
    matplotlib \
    scikit-learn \
    wget



############## MS3 ##################

FROM intel-levelzero-opencl-xpu-tensorflow \
    AS intel-levelzero-opencl-xpu-tensorflow_jupyter


# -----------------------------------
# Jupyter 및 데이터 분석/딥러닝 실습
# -----------------------------------
RUN python -m pip install --user --no-cache-dir \
    notebook \
    jupyterlab \
    ipywidgets \
    ipykernel


# -----------------------------------
# Jupyter 기본 설정 디렉토리
# -----------------------------------
RUN mkdir -p /home/dev/.jupyter


# -----------------------------------
# Jupyter 포트
# -----------------------------------
EXPOSE 8888


# -----------------------------------
# tini init process
# -----------------------------------
ENTRYPOINT ["/usr/bin/tini", "--"]


# -----------------------------------
# 기본 실행
# -----------------------------------
CMD ["jupyter", "lab", \
     "--ip=0.0.0.0", \
     "--port=8888", \
     "--no-browser", \
     "--ServerApp.token=", \
     "--ServerApp.allow_origin=*"]