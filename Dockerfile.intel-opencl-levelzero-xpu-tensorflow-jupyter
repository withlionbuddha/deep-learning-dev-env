FROM intel-levelzero-opencl-xpu-tensorflow AS intel-levelzero-opencl-xpu-tensorflow_jupyter

# -----------------------------------
# Jupyter 및 데이터 분석/딥러닝 실습
# -----------------------------------
RUN python -m pip install --user --no-cache-dir \
    notebook \
    jupyterlab \
    ipywidgets \
    ipykernel

# -----------------------------------
# Jupyter 기본 설정 디렉토리
# -----------------------------------
RUN mkdir -p /home/dev/.jupyter

# -----------------------------------
# Jupyter 포트
# -----------------------------------
EXPOSE 8888

# -----------------------------------
# tini init process
# -----------------------------------
ENTRYPOINT ["/usr/bin/tini", "--"]

# -----------------------------------
# 기본 실행
# -----------------------------------
CMD ["jupyter", "lab", \
     "--ip=0.0.0.0", \
     "--port=8888", \
     "--no-browser", \
     "--ServerApp.token=", \
     "--ServerApp.allow_origin=*"]