FROM python:3.10-slim-bookworm

# -----------------------------------
# 기본 환경 변수
# -----------------------------------
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

# -----------------------------------
# Intel 내장 GPU의 영상 디코딩/인코딩 가속 사용
# -----------------------------------
ENV LIBVA_DRIVER_NAME=iHD

ENV HOME=/home/dev
ENV SHELL=/bin/bash

ENV PATH=/home/dev/.local/bin:$PATH
ENV XDG_CACHE_HOME=/home/dev/.cache

# -----------------------------------
# 시스템 패키지 설치
# -----------------------------------
RUN apt-get update && apt-get install -y \
    sudo \
    curl \
    wget \
    vim \
    nano \
    tini \
    build-essential \
    gcc \
    g++ \
    make \
    pkg-config \
    ca-certificates \
    openssh-client \
    iputils-ping \
    net-tools \
    procps \
 && rm -rf /var/lib/apt/lists/*

# -----------------------------------
# Intel GPU 관련 패키지 설치
# OpenVINO GPU 추론을 위한 OpenCL 런타임 및 확인 도구
# -----------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    intel-opencl-icd \
    ocl-icd-libopencl1 \
    clinfo \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# -----------------------------------
# Intel 영상 가속 관련 패키지 설치
# VA-API 기반 영상 디코딩/인코딩 확인용
# OpenVINO 추론만 목적이면 생략 가능
# -----------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    intel-media-va-driver \
    vainfo \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*


# -----------------------------------
# 일반 사용자 생성
# -----------------------------------
RUN useradd -m -s /bin/bash dev \
 && echo "dev ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# -----------------------------------
# 작업 디렉토리 생성
# -----------------------------------
RUN mkdir -p /home/workspace \
 && chown -R dev:dev /home/workspace

# -----------------------------------
# 사용자 전환
# -----------------------------------
USER dev

WORKDIR /home/workspace

# -----------------------------------
# pip 최신화
# -----------------------------------
RUN python -m pip install --user --upgrade \
    pip \
    setuptools \
    wheel

# -----------------------------------
# Intel AI 추론(inference) 최적화 프레임워크  설치
# -----------------------------------
RUN python -m pip install --user --no-cache-dir \
    openvino \
    onnx

# -----------------------------------
# Python 패키지 설치
# Jupyter 및 데이터 분석/딥러닝 실습 기본 패키지
# -----------------------------------
RUN python -m pip install --user --no-cache-dir \
    notebook \
    jupyterlab \
    ipywidgets \
    numpy \
    pandas \
    matplotlib \
    scikit-learn \
    ipykernel 

# -----------------------------------
# Jupyter 기본 설정 디렉토리 생성
# -----------------------------------
RUN mkdir -p /home/dev/.jupyter

# -----------------------------------
# Jupyter 포트 오픈
# -----------------------------------
EXPOSE 8891

# -----------------------------------
# tini init process
# -----------------------------------
ENTRYPOINT ["/usr/bin/tini", "--"]

# -----------------------------------
# 기본 실행
# -----------------------------------
CMD ["jupyter", "lab", \
     "--ip=0.0.0.0", \
     "--port=8891", \
     "--no-browser", \
     "--ServerApp.token=", \
     "--ServerApp.allow_origin=*"]