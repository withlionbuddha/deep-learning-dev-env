{
  "name": "wsl-intel-xpu-openvino-dev-env",
  "service": "wsl-intel-xpu-openvino-dev",
  "dockerComposeFile": [
    "../../docker-compose-wsl-intel-xpu-openvino.yml"
  ],
  "workspaceFolder": "/home/workspace",
  "overrideCommand": true,
  "forwardPorts": [8888],
  "postStartCommand": [
    "sh",
    "-c",
    "ln -s /home/drive /home/workspace/drive "
  ] ,
  "runServices":["wsl-intel-xpu-openvino-dev"],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter",
        "ms-toolsai.jupyter-keymap",
        "ms-toolsai.jupyter-renderers",
        "ms-azuretools.vscode-docker"]
      ,"settings": {
        "remote.extensionKind": {
          "github.copilot": ["ui"],
          "github.copilot-chat": ["ui"]
        }
      }
    }
  }
}