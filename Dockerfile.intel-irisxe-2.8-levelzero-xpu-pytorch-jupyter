FROM ubuntu:22.04 AS intel-levelzero-xpu-jupyter

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# -----------------------------------
# 기본 환경 변수
# -----------------------------------
ENV DEBIAN_FRONTEND=noninteractive \
    HOME=/home/dev \
    SHELL=/bin/bash \
    PATH=/home/dev/.local/bin:$PATH \
    XDG_CACHE_HOME=/home/dev/.cache \
    LD_LIBRARY_PATH=/usr/lib/wsl/lib:$LD_LIBRARY_PATH \
    OMP_NUM_THREADS=6 \
    MKL_NUM_THREADS=6 \
    OPENBLAS_NUM_THREADS=6 \
    NUMEXPR_NUM_THREADS=6

# -----------------------------------
# 시스템 패키지 설치
# -----------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    sudo \
    curl \
    wget \
    vim \
    nano \
    tini \
    build-essential \
    gcc \
    g++ \
    make \
    pkg-config \
    ca-certificates \
    openssh-client \
    iputils-ping \
    net-tools \
    procps \
    gnupg \
    gpg-agent \
    python3 \
    python3-pip \
    python3-venv \
    python-is-python3 \
 && rm -rf /var/lib/apt/lists/*

# -----------------------------------
# Intel GPU runtime 저장소 추가
# Ubuntu 22.04 / WSL2 / Docker 실험용 구성
# 기존 repositories.intel.com/graphics/ubuntu jammy arc 보다 최신 client repo를 우선 사용한다.
# -----------------------------------
RUN wget -qO - https://repositories.intel.com/gpu/intel-graphics.key | \
    gpg --dearmor --output /usr/share/keyrings/intel-graphics.gpg \
 && echo "deb [arch=amd64,i386 signed-by=/usr/share/keyrings/intel-graphics.gpg] https://repositories.intel.com/gpu/ubuntu jammy client" \
    > /etc/apt/sources.list.d/intel-gpu-jammy.list \
 && dpkg --add-architecture i386 \
 && apt-get update

# -----------------------------------
# Intel GPU Runtime
# PyTorch XPU는 Level Zero 경로를 사용한다.
# 배포 시점에 따라 패키지명이 다를 수 있어 core는 필수 설치, dev/보조 패키지는 가능한 경우만 설치한다.
# -----------------------------------
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
    intel-opencl-icd \
    intel-level-zero-gpu \
    clinfo \
 && for pkg in \
    libze1 \
    libze-dev \
    intel-ocloc \
    intel-level-zero-gpu-dev \
    level-zero \
    level-zero-dev \
    libigc1 \
    intel-igc-cm \
    libigdgmm12; do \
      apt-get install -y --no-install-recommends "$pkg" || true; \
    done \
 && rm -rf /var/lib/apt/lists/*

# -----------------------------------
# Intel GPU Runtime 보조 패키지
# 없는 패키지는 건너뛴다.
# -----------------------------------
RUN apt-get update \
 && for pkg in \
    intel-media-va-driver-non-free \
    libmfx1 \
    libmfxgen1 \
    libvpl2 \
    libegl-mesa0 \
    libegl1-mesa \
    libgbm1 \
    libgl1-mesa-dri \
    libglx-mesa0 \
    mesa-va-drivers \
    mesa-vulkan-drivers \
    va-driver-all; do \
      apt-get install -y --no-install-recommends "$pkg" || true; \
    done \
 && rm -rf /var/lib/apt/lists/*

# -----------------------------------
# Intel oneAPI repository 추가
# -----------------------------------
RUN mkdir -p /usr/share/keyrings \
 && wget -qO - https://apt.repos.intel.com/intel-gpg-keys/GPG-PUB-KEY-INTEL-SW-PRODUCTS.PUB \
    | gpg --dearmor -o /usr/share/keyrings/oneapi-archive-keyring.gpg \
 && echo "deb [signed-by=/usr/share/keyrings/oneapi-archive-keyring.gpg] https://apt.repos.intel.com/oneapi all main" \
    > /etc/apt/sources.list.d/oneAPI.list \
 && apt-get update

# -----------------------------------
# Intel oneAPI 런타임 일부
# pip wheel 사용 시 전체 Deep Learning Essentials는 일반적으로 자동 의존성으로 처리된다.
# 그래도 libimf 계열 런타임 경로는 등록한다.
# -----------------------------------
RUN apt-get update \
 && apt-get install -y --no-install-recommends intel-oneapi-runtime-compilers \
 && rm -rf /var/lib/apt/lists/* \
 && find /opt/intel/oneapi -name "libimf.so*" -exec dirname {} \; | sort -u > /etc/ld.so.conf.d/intel-oneapi.conf \
 && ldconfig

# -----------------------------------
# 일반 사용자 생성
# -----------------------------------
RUN useradd -m -s /bin/bash dev \
 && echo "dev ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers \
 && mkdir -p /home/workspace \
 && chown -R dev:dev /home/workspace /home/dev

USER dev
WORKDIR /home/workspace

# -----------------------------------
# pip 최신화 및 기본 Python 패키지 설치
# -----------------------------------
RUN python -m pip install --user --upgrade pip setuptools wheel

RUN python -m pip install --user --no-cache-dir \
    numpy \
    pandas \
    matplotlib \
    scikit-learn \
    threadpoolctl

############## MS2 ##############

FROM intel-levelzero-xpu-jupyter AS intel-levelzero-xpu-pytorch-jupyter

# -----------------------------------
# Intel GPU용 PyTorch XPU 설치
# -----------------------------------
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# -----------------------------------
# Intel Iris Xe 0x46a6 실험용 PyTorch XPU 조합
# 확인된 공식 wheel: torch 2.8.0+xpu / torchvision 0.23.0+xpu / torchaudio 2.8.0+xpu
# 주의: 0x46a6은 공식 검증 GPU 목록에 명시되어 있지 않았지만 초기화 됨.
# -----------------------------------
ARG PYTORCH_VERSION=2.8.0+xpu
ARG TORCHVISION_VERSION=0.23.0+xpu
ARG TORCHAUDIO_VERSION=2.8.0+xpu

RUN python -m pip uninstall -y \
    torch \
    torchvision \
    torchaudio \
    pytorch-triton-xpu \
    intel-extension-for-pytorch \
 || true

RUN python -m pip install --user --no-cache-dir --force-reinstall \
    --timeout 180 \
    --retries 10 \
    --index-url https://download.pytorch.org/whl/xpu \
    --extra-index-url https://pypi.org/simple \
    "torch==${PYTORCH_VERSION}" \
    "torchvision==${TORCHVISION_VERSION}" \
    "torchaudio==${TORCHAUDIO_VERSION}"


############## MS3 ############## 

FROM intel-levelzero-xpu-pytorch-jupyter

# -----------------------------------
# Jupyter 및 데이터 분석/딥러닝 실습 기본 패키지
# -----------------------------------
RUN python -m pip install --user --no-cache-dir \
    notebook \
    jupyterlab \
    ipywidgets

# -----------------------------------
# Jupyter 기본 설정 디렉토리 생성
# -----------------------------------
RUN mkdir -p /home/dev/.jupyter

# -----------------------------------
# Jupyter 포트 오픈
# -----------------------------------
EXPOSE 8888

# -----------------------------------
# tini init process
# -----------------------------------
ENTRYPOINT ["/usr/bin/tini", "--"]

# -----------------------------------
# 기본 실행
# -----------------------------------
CMD ["jupyter", "lab", \
     "--ip=0.0.0.0", \
     "--port=8888", \
     "--no-browser", \
     "--ServerApp.token=", \
     "--ServerApp.allow_origin=*"]
