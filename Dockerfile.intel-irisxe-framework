# syntax=docker/dockerfile:1.7

ARG FRAMEWORK=pytorch

############## Common Intel Iris Xe runtime ##############
FROM ubuntu:22.04 AS intel-irisxe-base

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

ENV DEBIAN_FRONTEND=noninteractive \
    HOME=/home/dev \
    SHELL=/bin/bash \
    PATH=/home/dev/.local/bin:$PATH \
    XDG_CACHE_HOME=/home/dev/.cache \
    LD_LIBRARY_PATH=/usr/lib/wsl/lib:$LD_LIBRARY_PATH \
    OMP_NUM_THREADS=6 \
    MKL_NUM_THREADS=6 \
    OPENBLAS_NUM_THREADS=6 \
    NUMEXPR_NUM_THREADS=6

RUN apt-get update && apt-get install -y --no-install-recommends \
    sudo curl wget vim nano tini build-essential gcc g++ make pkg-config \
    ca-certificates openssh-client iputils-ping net-tools procps gnupg gpg-agent \
    python3 python3-pip python3-venv python-is-python3 \
 && rm -rf /var/lib/apt/lists/*

# Intel GPU client repository: shared by PyTorch XPU and TensorFlow ITEX.
RUN wget -qO - https://repositories.intel.com/gpu/intel-graphics.key | \
    gpg --dearmor --output /usr/share/keyrings/intel-graphics.gpg \
 && echo "deb [arch=amd64,i386 signed-by=/usr/share/keyrings/intel-graphics.gpg] https://repositories.intel.com/gpu/ubuntu jammy client" \
    > /etc/apt/sources.list.d/intel-gpu-jammy.list \
 && dpkg --add-architecture i386 \
 && apt-get update

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
    intel-opencl-icd intel-level-zero-gpu clinfo \
 && for pkg in libze1 libze-dev intel-ocloc intel-level-zero-gpu-dev level-zero level-zero-dev libigc1 intel-igc-cm libigdgmm12; do \
      apt-get install -y --no-install-recommends "$pkg" || true; \
    done \
 && rm -rf /var/lib/apt/lists/*

RUN apt-get update \
 && for pkg in intel-media-va-driver-non-free libmfx1 libmfxgen1 libvpl2 libegl-mesa0 libegl1-mesa libgbm1 libgl1-mesa-dri libglx-mesa0 mesa-va-drivers mesa-vulkan-drivers va-driver-all; do \
      apt-get install -y --no-install-recommends "$pkg" || true; \
    done \
 && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /usr/share/keyrings \
 && wget -qO - https://apt.repos.intel.com/intel-gpg-keys/GPG-PUB-KEY-INTEL-SW-PRODUCTS.PUB \
    | gpg --dearmor -o /usr/share/keyrings/oneapi-archive-keyring.gpg \
 && echo "deb [signed-by=/usr/share/keyrings/oneapi-archive-keyring.gpg] https://apt.repos.intel.com/oneapi all main" \
    > /etc/apt/sources.list.d/oneAPI.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends intel-oneapi-runtime-compilers \
 && rm -rf /var/lib/apt/lists/* \
 && find /opt/intel/oneapi -name "libimf.so*" -exec dirname {} \; | sort -u > /etc/ld.so.conf.d/intel-oneapi.conf \
 && ldconfig

RUN useradd -m -s /bin/bash dev \
 && echo "dev ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers \
 && mkdir -p /home/workspace \
 && chown -R dev:dev /home/workspace /home/dev

USER dev
WORKDIR /home/workspace

RUN python -m pip install --user --upgrade pip setuptools wheel \
 && python -m pip install --user --no-cache-dir \
    numpy pandas matplotlib scikit-learn threadpoolctl wget \
    jupyterlab notebook ipykernel

############## PyTorch ##############
FROM intel-irisxe-base AS pytorch

ARG PYTORCH_VERSION=2.8.0+xpu
ARG TORCHVISION_VERSION=0.23.0+xpu
ARG TORCHAUDIO_VERSION=2.8.0+xpu

RUN python -m pip uninstall -y torch torchvision torchaudio pytorch-triton-xpu intel-extension-for-pytorch || true \
 && python -m pip install --user --no-cache-dir --force-reinstall \
    --timeout 180 --retries 10 \
    --index-url https://download.pytorch.org/whl/xpu \
    --extra-index-url https://pypi.org/simple \
    "torch==${PYTORCH_VERSION}" \
    "torchvision==${TORCHVISION_VERSION}" \
    "torchaudio==${TORCHAUDIO_VERSION}" \
 && python -m pip check

ENV DEEP_LEARNING_FRAMEWORK=pytorch

############## TensorFlow ##############
FROM intel-irisxe-base AS tensorflow

# TensorFlow 2.15.1 + latest available ITEX 2.15 patch release on the configured pip index.
# Iris Xe 0x46a6 XPU availability still requires runtime verification.
ARG TENSORFLOW_VERSION=2.15.1
ARG ITEX_VERSION=2.15.0.2

ENV TF_ENABLE_ONEDNN_OPTS=1 \
    UR_L0_ENABLE_RELAXED_ALLOCATION_LIMITS=1

RUN python -m pip install --user --no-cache-dir \
    "tensorflow==${TENSORFLOW_VERSION}" \
    "intel-extension-for-tensorflow[xpu]==${ITEX_VERSION}" \
 && python -m pip check

ENV DEEP_LEARNING_FRAMEWORK=tensorflow

############## Selected runtime ##############
FROM ${FRAMEWORK} AS runtime

WORKDIR /home/workspace

CMD ["sleep", "infinity"]
